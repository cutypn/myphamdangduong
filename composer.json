{
  "name": "bizrise/ddg-v2",
  "description": "Bizrise Framework implementation for Dang Duong Group V2",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Bizrise\\Core\\": "apps/bizrise-core/src/",
      "Bizrise\\DDG\\Migrator\\": "apps/bizrise-ddg-migrator/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
